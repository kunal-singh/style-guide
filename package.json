{
  "name": "style-guide",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --filter @kunal-singh/init build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --filter @kunal-singh/init typecheck",
    "prepare": "lefthook install",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "latest",
    "@changesets/cli": "latest",
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@kunal-singh/commitlint-config": "workspace:*",
    "@kunal-singh/eslint-config": "workspace:*",
    "@kunal-singh/prettier-config": "workspace:*",
    "@kunal-singh/typescript-config": "workspace:*",
    "eslint": "latest",
    "lefthook": "latest",
    "lint-staged": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  }
}
